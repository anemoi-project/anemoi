+def evg_draft_attention(
+    query, key, value, visual_len, text_mask, sparsity_ratio, attn_param
+):
+    """Run EVG Draft Attention on the full image+text sequence."""
+    latent_t, latent_h, latent_w = attn_param["thw"]
+    expected_visual_len = latent_t * latent_h * latent_w
+    if visual_len != expected_visual_len:
+        raise ValueError(
+            f"EVG Draft Attention expected {expected_visual_len} visual tokens from "
+            f"thw={attn_param['thw']}, got {visual_len}"
+        )
+
+    pool_h = attn_param["evg_draft_pool_h"]
+    pool_w = attn_param["evg_draft_pool_w"]
+    text_len = query.shape[1] - visual_len
+    cache_key = (
+        str(query.device),
+        latent_h,
+        latent_w,
+        visual_len,
+        text_len,
+        pool_h,
+        pool_w,
+        sparsity_ratio,
+        attn_param["evg_draft_q_chunk_size"],
+        attn_param["evg_draft_k_chunk_size"],
+        attn_param["evg_draft_backend"],
+        attn_param["evg_draft_profile"],
+    )
+    draft_attention = _evg_draft_attention_cache.get(cache_key)
+    if draft_attention is None:
+        draft_attention = DraftAttention(
+            DraftAttentionConfig(
+                latent_h=latent_h,
+                latent_w=latent_w,
+                visual_len=visual_len,
+                text_len=text_len,
+                pool_h=pool_h,
+                pool_w=pool_w,
+                sparsity_ratio=sparsity_ratio,
+                draft_q_chunk_size=attn_param["evg_draft_q_chunk_size"],
+                draft_k_chunk_size=attn_param["evg_draft_k_chunk_size"],
+                backend=attn_param["evg_draft_backend"],
+                profile=attn_param["evg_draft_profile"],
+            )
+        )
+        _evg_draft_attention_cache[cache_key] = draft_attention
+        logger.info(
+            "Initialized EVG Draft Attention for "
+            f"thw={latent_t}x{latent_h}x{latent_w}, text_len={text_len}, "
+            f"sparsity={sparsity_ratio:.3f}, pool={pool_h}x{pool_w}"
+        )
+
+    if text_mask is not None:
+        token_mask = F.pad(text_mask.to(torch.bool), (visual_len, 0), value=True)
+    else:
+        token_mask = None
+    return draft_attention(query, key, value, attn_mask=token_mask)
+
